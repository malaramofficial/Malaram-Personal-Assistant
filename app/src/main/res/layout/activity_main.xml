<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="माला राम जी का Personal Assistant" android:textSize="24sp" android:textStyle="bold"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="बोलकर आदेश देने के लिए नीचे बटन दबाएँ।"/>
    <Button android:id="@+id/listenButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:text="🎙️ बोलें"/>
    <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Accessibility चालू करें"/>
</LinearLayout>
